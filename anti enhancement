		local function safe_cc(fn)
			if type(newcclosure) == "function" then
				local ok, r = pcall(newcclosure, fn)
				if ok and r then return r end
			end
			return fn
		end
		local function safe_hook(target, rep)
			if type(hookfunction) ~= "function" then return nil end
			local ok, r = pcall(hookfunction, target, rep)
			if ok then return r end
			return nil
		end

		env._installHarionSkin = function()
			if SkinState.Ready then
