		local function applyInfoOptions(item)
			local info = item and item.Info
			if type(info) ~= "table" then return end
			local fireRate = math.max((weaponState.FireRate or 100) / 100, 0.01)
			local fastShoot = weaponState.Enabled and weaponState.FastShoot
			local noSpread = weaponState.Enabled and weaponState.NoSpread
			local recoil = rememberInfo(info, "ShootRecoil")
			if recoil ~= nil then info.ShootRecoil = (fastShoot or noSpread) and 0 or recoil end
			local spread = rememberInfo(info, "ShootSpread")
			if spread ~= nil then info.ShootSpread = (fastShoot or noSpread) and 0 or spread end
			for _, sk in ipairs({"Spread", "BulletSpread", "MaxSpread", "MinSpread", "Bloom"}) do
				local ov = rememberInfo(info, sk)
				if ov ~= nil then info[sk] = (fastShoot or noSpread) and 0 or ov end
			end
			local ps = rememberInfo(info, "ProjectileSpeed")
			if ps ~= nil then info.ProjectileSpeed = fastShoot and 99999999 or ps end
			for _, key in ipairs({"ShootCooldown","QuickShotCooldown","BurstCooldown","AttackCooldown","Cooldown","HeavyAttackCooldown"}) do
				local original = rememberInfo(info, key)
				if original ~= nil then
					if fastShoot then info[key] = 0
					elseif fireRate ~= 1 and (key == "ShootCooldown" or key == "QuickShotCooldown" or key == "BurstCooldown") then
						info[key] = original / fireRate
					else info[key] = original end
