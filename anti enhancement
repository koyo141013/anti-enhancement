			local function applySkyPreset(preset)
				pcall(function()
					for _, s in ipairs(Lighting:GetChildren()) do
						if s:IsA("Sky") then s:Destroy() end
					end
					if not preset or not preset.sky then
						if _skyOriginal then
							_skyOriginal:Clone().Parent = Lighting
						end
						return
					end
					local sky = Instance.new("Sky")
					sky.Name = "AntiRivalSky"
					for k, v in pairs(preset.sky) do
						if v ~= nil and v ~= "" then
							pcall(function() sky[k] = v end)
						end
					end
					sky.Parent = Lighting
				end)
			end

