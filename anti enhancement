			end
			local ok, err = pcall(function()
				local lp = player
				local modules = ReplicatedStorage:FindFirstChild("Modules")
				if not modules then error("Modules missing") end
				local ps = lp:FindFirstChild("PlayerScripts") or lp:WaitForChild("PlayerScripts", 3)
				local ctrls = ps and (ps:FindFirstChild("Controllers") or ps:WaitForChild("Controllers", 3))
				if not ctrls then error("Controllers missing") end

				local clib, dctrl, fctrl
				pcall(function() clib = require(modules:FindFirstChild("CosmeticLibrary") or modules.CosmeticLibrary) end)
				pcall(function() dctrl = require(ctrls:FindFirstChild("PlayerDataController") or ctrls.PlayerDataController) end)
				pcall(function() fctrl = require(ctrls:FindFirstChild("FighterController") or ctrls.FighterController) end)
				if not clib or type(clib.Cosmetics) ~= "table" then error("CosmeticLibrary missing") end
				if not dctrl then error("PlayerDataController missing") end

				local equip = SkinState.equip
				local coss = clib.Cosmetics

				local function banned(n)
					if type(n) ~= "string" then return true end
					return n:find("MISSING_") or n:find("Bubblegum") or n:find("Ragdoll")
				end
				local function clonecos(name, ctype)
					if banned(name) then return nil end
					local base = coss[name]
					if type(base) ~= "table" then return nil end
					local d = {}
					for k, v in pairs(base) do d[k] = v end
					d.Name = name
					d.Type = d.Type or ctype
					d.Owned = true
					d.Unlocked = true
					return d
				end

				-- GetWeaponData ONLY — with re-entrancy guard (fixes C stack overflow)
				if not SkinState.WDHooked and type(dctrl.GetWeaponData) == "function" then
					local ogetwep = dctrl.GetWeaponData
					local inWD = false
					local hooked = safe_cc(function(self, wname, ...)
						if inWD then
							return ogetwep(self, wname, ...)
						end
						inWD = true
						local ok2, data = pcall(ogetwep, self, wname, ...)
						inWD = false
						if not ok2 then return nil end
						if type(data) ~= "table" then return data end
						local weq = type(wname) == "string" and equip[wname] or nil
						if type(weq) ~= "table" or not next(weq) then
							return data
						end
						local merged = {}
						for k, v in pairs(data) do merged[k] = v end
						merged.Name = wname
						for ct, cd in pairs(weq) do
							if type(cd) == "table" then merged[ct] = cd end
						end
						merged.Level = data.Level
						merged.Prestige = data.Prestige
						merged.XP = data.XP
						return merged
					end)
					local hf = safe_hook(dctrl.GetWeaponData, hooked)
					if not hf then
						pcall(function()
							local mt = getmetatable(dctrl)
							local idx = mt and rawget(mt, "__index")
							if type(idx) == "table" and type(rawget(idx, "GetWeaponData")) == "function" then
								local old = rawget(idx, "GetWeaponData")
								ogetwep = old
								rawset(idx, "GetWeaponData", hooked)
							else
								dctrl.GetWeaponData = hooked
							end
						end)
					else
						ogetwep = hf
					end
					SkinState.WDHooked = true
				end

				-- NO dctrl.Get hook, NO EquipCosmetic intercept, NO Replicate
