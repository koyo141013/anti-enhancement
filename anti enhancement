								local n = 0
								for name, data in pairs(coss) do
									if type(name) == "string" and type(data) == "table" and not banned(name) then
										if tostring(data.Type) == "Skin" and cosmeticMatchesWeapon(data, weaponName) then
											table.insert(skins, name)
										end
									end
									n = n + 1
									if n % 80 == 0 then task.wait() end
								end
								table.sort(skins)
								clearBtns(right)
								local cols, cellW, cellH = 4, 128, 36
								for i, skinName in ipairs(skins) do
									local col = (i - 1) % cols
									local row = math.floor((i - 1) / cols)
									local b = Instance.new("TextButton")
									b.Size = UDim2.fromOffset(cellW, cellH)
									b.Position = UDim2.fromOffset(6 + col * (cellW + 6), 4 + row * (cellH + 4))
									b.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
									b.BorderColor3 = Color3.fromRGB(50, 50, 50)
									b.BorderSizePixel = 1
									b.Text = skinName
									b.TextColor3 = Color3.fromRGB(230, 230, 230)
									b.TextSize = 11
									b.Font = Enum.Font.Code
									b.TextTruncate = Enum.TextTruncate.AtEnd
									b.Parent = right
									b.MouseButton1Click:Connect(function()
										local applied = false
										pcall(function()
											if env._installHarionSkin then env._installHarionSkin() end
											if env._applyCosmeticToWeapon then
												applied = env._applyCosmeticToWeapon(weaponName, skinName, "Skin") == true
											end
										end)
										if applied then
											status.Text = "Applied " .. skinName .. " → " .. weaponName
											status.TextColor3 = Color3.fromRGB(120, 220, 140)
										else
											status.Text = "Apply failed (wait for Skin system ready / join match)"
											status.TextColor3 = Color3.fromRGB(255, 180, 100)
										end
									end)
									if i % 24 == 0 then task.wait() end
								end
								local rows = math.ceil(math.max(#skins, 1) / cols)
								right.CanvasSize = UDim2.fromOffset(0, math.max(520, rows * (cellH + 4) + 12))
								status.Text = weaponName .. " — " .. #skins .. " skins (picking weapon does nothing to loadout)"
