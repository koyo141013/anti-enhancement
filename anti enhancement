			local function updateSlider(inputPos)
				local posRatio = math.clamp((inputPos - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
				local val = math.floor(minVal + ((maxVal - minVal) * posRatio))
				fill.Size = UDim2.new(posRatio, 0, 1, 0)
				knob.Position = UDim2.new(posRatio, 0, 0.5, 0)
				label.Text = text .. ": " .. tostring(val)
				callback(val)
			end

			sliderBg.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					draggingSlider = true
					updateSlider(input.Position.X)
