			do -- ESP isolated scope (register limit)
			local function __setupEsp()
				local espCache = {}
				local hasDrawing = type(Drawing) == "table" and type(Drawing.new) == "function"

				local function espRGB(key, fallback)
					local t = S[key]
					if type(t) == "table" and t[1] then
						return Color3.fromRGB(t[1], t[2], t[3])
					end
					return fallback
				end

				local function destroyDraw(obj)
					if not obj then return end
					pcall(function()
						obj.Visible = false
						if obj.Remove then obj:Remove() elseif obj.Destroy then obj:Destroy() end
					end)
				end

				local function removeEsp(p)
					local c = espCache[p]
					if not c then return end
					if c.Box then
						for _, d in pairs(c.Box) do destroyDraw(d) end
					end
					destroyDraw(c.Name)
					destroyDraw(c.Info)
					destroyDraw(c.Health)
					destroyDraw(c.HealthBg)
					pcall(function() if c.Highlight then c.Highlight:Destroy() end end)
					espCache[p] = nil
				end

				local function ensureBox(c, col)
					if not hasDrawing then return end
					if not c.Box then
						c.Box = {}
						for i = 1, 4 do
							local line = Drawing.new("Line")
							line.Thickness = 1.5
							line.Color = col
							line.Visible = false
							c.Box[i] = line
						end
					end
					for i = 1, 4 do
						if c.Box[i] then c.Box[i].Color = col end
					end
				end

				local function setLine(line, x1, y1, x2, y2, col, vis)
					if not line then return end
					line.From = Vector2.new(x1, y1)
					line.To = Vector2.new(x2, y2)
					line.Color = col
					line.Visible = vis and true or false
				end

				local function updateEspForPlayer(p)
					if p == player then return end
					local char = p.Character
					local hum = char and char:FindFirstChildOfClass("Humanoid")
					local hrp = char and char:FindFirstChild("HumanoidRootPart")
					local any = S.espOn or S.espEnemyBox or S.namesOn or S.healthOn or S.espEnemyDistance or S.espHeldWeapon
					if not any or not char or not hrp or not hum or hum.Health <= 0 then
						removeEsp(p)
						return
					end

					local cam = Workspace.CurrentCamera
					if not cam then return end
					local ok, pos, onScreen = pcall(function()
						return cam:WorldToViewportPoint(hrp.Position)
					end)
					if not ok or not onScreen then
						removeEsp(p)
						return
					end

					local c = espCache[p] or {}
					local col = espRGB("espColorBox", Color3.fromRGB(80, 255, 120))
					local nameCol = espRGB("espColorName", Color3.fromRGB(255, 255, 255))

					-- Highlight fallback
					if S.espOn or S.espEnemyBox or S.espGeometry then
						if not c.Highlight or not c.Highlight.Parent then
							local hl = Instance.new("Highlight")
							hl.Name = "AE_ESP"
							hl.Adornee = char
							hl.FillColor = col
							hl.OutlineColor = col
							hl.FillTransparency = 0.85
							hl.OutlineTransparency = 0.2
							pcall(function() hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop end)
							hl.Parent = char
							c.Highlight = hl
						else
							c.Highlight.Adornee = char
							c.Highlight.FillColor = col
							c.Highlight.OutlineColor = col
						end
					elseif c.Highlight then
						pcall(function() c.Highlight:Destroy() end)
						c.Highlight = nil
					end

					if hasDrawing and (S.espOn or S.espEnemyBox) then
						local sizeY = hrp.Size.Y * 2
						local top = cam:WorldToViewportPoint(hrp.Position + Vector3.new(0, sizeY * 0.55, 0))
						local bot = cam:WorldToViewportPoint(hrp.Position - Vector3.new(0, sizeY * 0.55, 0))
						local h = math.max(12, math.abs(bot.Y - top.Y))
						local w = h * 0.55
						local x1, y1 = pos.X - w / 2, pos.Y - h / 2
						local x2, y2 = pos.X + w / 2, pos.Y + h / 2
						ensureBox(c, col)
						setLine(c.Box[1], x1, y1, x2, y1, col, true)
						setLine(c.Box[2], x2, y1, x2, y2, col, true)
						setLine(c.Box[3], x2, y2, x1, y2, col, true)
						setLine(c.Box[4], x1, y2, x1, y1, col, true)

						if S.namesOn or S.espOn then
							if not c.Name then
								c.Name = Drawing.new("Text")
								c.Name.Center = true
								c.Name.Outline = true
								c.Name.Size = 16
							end
							c.Name.Text = p.DisplayName or p.Name
							c.Name.Color = nameCol
							c.Name.Position = Vector2.new(pos.X, y1 - 16)
							c.Name.Visible = true
						elseif c.Name then
							c.Name.Visible = false
						end

						if S.healthOn then
							if not c.HealthBg then
								c.HealthBg = Drawing.new("Line")
								c.HealthBg.Thickness = 3
								c.HealthBg.Color = Color3.new(0, 0, 0)
								c.HealthBg.ZIndex = 1
							end
							if not c.Health then
								c.Health = Drawing.new("Line")
								c.Health.Thickness = 1.5
								c.Health.ZIndex = 2
							end
							local pct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
							local hx = x1 - 5
							c.HealthBg.From = Vector2.new(hx, y1)
							c.HealthBg.To = Vector2.new(hx, y2)
							c.HealthBg.Visible = true
							c.Health.From = Vector2.new(hx, y2 - (y2 - y1) * pct)
							c.Health.To = Vector2.new(hx, y2)
							c.Health.Color = Color3.fromRGB(255 * (1 - pct), 255 * pct, 80)
							c.Health.Visible = true
						else
							if c.Health then c.Health.Visible = false end
							if c.HealthBg then c.HealthBg.Visible = false end
						end

						local extra = {}
						if S.espEnemyDistance then
							local my = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
							if my then
								table.insert(extra, math.floor((hrp.Position - my.Position).Magnitude) .. " studs")
							end
						end
						if S.espHeldWeapon then
							local tool = char:FindFirstChildOfClass("Tool")
							table.insert(extra, tool and tool.Name or "?")
						end
						if #extra > 0 then
							if not c.Info then
								c.Info = Drawing.new("Text")
								c.Info.Center = true
								c.Info.Outline = true
								c.Info.Size = 14
							end
							c.Info.Text = table.concat(extra, " | ")
							c.Info.Color = espRGB("espColorDistance", Color3.fromRGB(144, 255, 160))
							c.Info.Position = Vector2.new(pos.X, y2 + 4)
							c.Info.Visible = true
						elseif c.Info then
							c.Info.Visible = false
						end
					else
						if c.Box then for _, d in pairs(c.Box) do d.Visible = false end end
						if c.Name then c.Name.Visible = false end
						if c.Info then c.Info.Visible = false end
						if c.Health then c.Health.Visible = false end
						if c.HealthBg then c.HealthBg.Visible = false end
					end

					espCache[p] = c
				end

				trackConn(RunService.RenderStepped:Connect(function()
					local any = S.espOn or S.espEnemyBox or S.namesOn or S.healthOn or S.espEnemyDistance or S.espHeldWeapon or S.espGeometry
					if not any then
						for p in pairs(espCache) do removeEsp(p) end
						return
					end
					for _, p in ipairs(Players:GetPlayers()) do
						pcall(updateEspForPlayer, p)
					end
				end))
				trackConn(Players.PlayerRemoving:Connect(function(p) removeEsp(p) end))
			end
			
			
			__setupEsp()
			end

			local function __setupExtraLoops()
				randomTpButton.MouseButton1Click:Connect(function()
					pcall(function()
						local _, myRoot = getSafeParts()
						if not myRoot then return end
						local validTargets = {}
						for _, p in ipairs(Players:GetPlayers()) do
							if p ~= player then
								local char = p.Character
								if char then
									local hum = char:FindFirstChildOfClass("Humanoid")
									local head = char:FindFirstChild("Head")
									if hum and hum.Health > 0 and head then table.insert(validTargets, head) end
								end
							end
						end
						if #validTargets > 0 then
							local randomHead = validTargets[math.random(1, #validTargets)]
							local randomAngle = math.random() * math.pi * 2
							local offsetDir = Vector3.new(math.cos(randomAngle), 0, math.sin(randomAngle))
							myRoot.CFrame = CFrame.new(randomHead.Position + (offsetDir * 5), randomHead.Position)
						end
					end)
				end)
	
				trackConn(RunService.RenderStepped:Connect(function()
					if not S.aimbotOn then return end
					if env._uiOpen or (env._mainWindow and env._mainWindow.Visible) then return end
					pcall(function()
						local currentCam = getActiveCamera()
						if not currentCam then return end
						local bestTarget = nil
						local shortestDist = math.huge
						local mousePos = UserInputService:GetMouseLocation()
						local myChar = player.Character

						local function isVisible(part)
							if not part or not myChar then return false end
							local origin = currentCam.CFrame.Position
							local dir = part.Position - origin
							local params = RaycastParams.new()
							params.FilterType = Enum.RaycastFilterType.Exclude
							params.FilterDescendantsInstances = {myChar}
							params.IgnoreWater = true
							local result = Workspace:Raycast(origin, dir, params)
							if not result then return true end
							local hitModel = result.Instance:FindFirstAncestorOfClass("Model")
							local targetModel = part:FindFirstAncestorOfClass("Model")
							if hitModel and targetModel and hitModel == targetModel then
								return true
							end
							-- hit something else (wall) first
							return false
						end

						local function pickParts(char)
							local mode = S.aimbotHitPart or "Both"
							local parts = {}
							if mode == "Head" or mode == "Both" then
								local h = char:FindFirstChild("Head") or char:FindFirstChild("HitboxHead")
								if h then table.insert(parts, h) end
							end
							if mode == "Body" or mode == "Both" then
								for _, n in ipairs({"HitboxBody", "UpperTorso", "HumanoidRootPart", "Torso", "HitboxBodySmall"}) do
									local p = char:FindFirstChild(n)
									if p then table.insert(parts, p); break end
								end
							end
							if #parts == 0 then
								local any = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
								if any then table.insert(parts, any) end
							end
							return parts
						end

						local function consider(part)
							if not part then return end
							if not isVisible(part) then return end
							local ok, screenPos, onScreen = pcall(function()
								return currentCam:WorldToViewportPoint(part.Position)
							end)
							if not ok or not onScreen then return end
							local d = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
							if d < shortestDist then
								shortestDist = d
								bestTarget = part
							end
						end

						local hasSelectedTarget = false
						for p, isSelected in pairs(selectedTargets) do
							if isSelected then
								hasSelectedTarget = true
								local skipKatana = false
								if S.antiKatanaOn and p.Character then
									local tool = p.Character:FindFirstChildOfClass("Tool")
									if tool and string.find(string.lower(tool.Name), "katana", 1, true) then
										skipKatana = true
									end
								end
								if not skipKatana then
									local char = p.Character
									if char then
										local hum = char:FindFirstChildOfClass("Humanoid")
										if hum and hum.Health > 0 then
											for _, part in ipairs(pickParts(char)) do
												consider(part)
											end
										end
									end
								end
							end
						end

						local function enemyHasKatana(plr)
							if not S.antiKatanaOn then return false end
							return _playerHoldingKatana and _playerHoldingKatana(plr) or false
						end

						if not bestTarget and not hasSelectedTarget then
							for _, p in ipairs(Players:GetPlayers()) do
								if p ~= player and not enemyHasKatana(p) then
									local char = p.Character
									if char then
										local hum = char:FindFirstChildOfClass("Humanoid")
										if hum and hum.Health > 0 then
											for _, part in ipairs(pickParts(char)) do
												consider(part)
											end
										end
									end
								end
							end
						end

						if bestTarget then
							local screenPos, onScreen = currentCam:WorldToViewportPoint(bestTarget.Position)
							if onScreen then
								local dx = screenPos.X - mousePos.X
								local dy = screenPos.Y - mousePos.Y
								local strength = math.clamp(tonumber(S.aimbotStrength) or 40, 1, 100) / 100
								local moveX = dx * strength
								local moveY = dy * strength
								if math.abs(moveX) < 0.15 and math.abs(moveY) < 0.15 then
									return
								end
								if mousemoverel then
									mousemoverel(moveX, moveY)
								else
									local vim = game:GetService("VirtualInputManager")
									if vim then
										vim:SendMouseMoveEvent(mousePos.X + moveX, mousePos.Y + moveY, game)
									end
								end
							end
						end
					end)
				end))

				trackConn(RunService.RenderStepped:Connect(function()
					if not S.auraOn then return end
					pcall(function()
						local _, root = getSafeParts()
						if not root then return end
						for _, p in ipairs(Players:GetPlayers()) do
							if p ~= player then
								local char = p.Character
								if char then
									local hum = char:FindFirstChildOfClass("Humanoid")
									local targetRoot = char:FindFirstChild("HumanoidRootPart")
									if hum and hum.Health > 0 and targetRoot and (targetRoot.Position - root.Position).Magnitude <= 20 then
										for _, tool in ipairs(player.Character:GetChildren()) do
											if tool:IsA("Tool") then tool:Activate() end
										end
									end
								end
							end
						end
					end)
				end))
	
				local lastTriggerCheck = 0
				trackConn(RunService.RenderStepped:Connect(function()
					if not S.triggerBotOn then return end
					local now = os.clock()
					if now - lastTriggerCheck < 0.04 then return end
					lastTriggerCheck = now

					pcall(function()
						local char = player.Character
						if not char then return end
						local currentCam = getActiveCamera()
						if not currentCam then return end

						local unitRay = currentCam:ViewportPointToRay(currentCam.ViewportSize.X / 2, currentCam.ViewportSize.Y / 2)
						local raycastParams = RaycastParams.new()
						raycastParams.FilterType = Enum.RaycastFilterType.Exclude
						raycastParams.FilterDescendantsInstances = {char}
						raycastParams.IgnoreWater = true

						local raycastResult = Workspace:Raycast(unitRay.Origin, unitRay.Direction * 2500, raycastParams)
						if not raycastResult or not raycastResult.Instance then return end

						local hit = raycastResult.Instance
						local model = hit:FindFirstAncestorOfClass("Model") or hit.Parent
						if not model then return end

						local hum = model:FindFirstChildOfClass("Humanoid")
						if not hum then
							-- Rivals hitboxes sometimes parent under folder; walk up
							local cur = hit
							for _ = 1, 6 do
								if not cur then break end
								if cur:IsA("Model") then
									hum = cur:FindFirstChildOfClass("Humanoid")
									if hum then model = cur; break end
								end
								cur = cur.Parent
							end
						end
						local p = Players:GetPlayerFromCharacter(model)
						if not p then
							-- try attribute / name match
							for _, plr in ipairs(Players:GetPlayers()) do
								if plr ~= player and plr.Character and (hit:IsDescendantOf(plr.Character) or (model and model == plr.Character)) then
									p = plr
									break
								end
							end
						end
						if hum and hum.Health > 0 and p and p ~= player then
							local fired = false
							for _, tool in ipairs(char:GetChildren()) do
								if tool:IsA("Tool") then
									pcall(function() tool:Activate() end)
									fired = true
								end
							end
							if not fired then
								pcall(function()
									local vim = game:GetService("VirtualInputManager")
									if vim then
										vim:SendMouseButtonEvent(0, 0, 0, true, game, 0)
										task.defer(function()
											pcall(function() vim:SendMouseButtonEvent(0, 0, 0, false, game, 0) end)
										end)
									end
								end)
							end
						end
					end)
				end))

				trackConn(RunService.Heartbeat:Connect(function()
					pcall(function()
						local char = player.Character
						local hum = char and char:FindFirstChildOfClass("Humanoid")
					
						if S.godModeOn and hum then
							hum.Health = hum.MaxHealth
						end
	
						-- wallbang handled in separate throttled loop (avoid freeze)
					end)
				end))
	
				trackConn(RunService.RenderStepped:Connect(function()
					if S.forceThirdPersonOn then
						pcall(function()
							player.CameraMode = Enum.CameraMode.Classic
							if player.CameraMinZoomDistance < 10 then player.CameraMinZoomDistance = 10 end
							local currentCam = getActiveCamera()
							if currentCam and currentCam.CameraType == Enum.CameraType.Scriptable then
								currentCam.CameraType = Enum.CameraType.Custom
							end
						end)
					end
				end))
	
				trackConn(RunService.RenderStepped:Connect(function()
					if S.orbitOn then
						pcall(function()
							local _, root = getSafeParts()
							if root then
								local t = os.clock() * 5
								root.CFrame = CFrame.new(root.Position + Vector3.new(math.cos(t) * 25, 10, math.sin(t) * 25))
							end
						end)
					elseif S.voidSpanOn then
						pcall(function()
							local _, root = getSafeParts()
							if root then root.CFrame = CFrame.new(root.Position + Vector3.new(0, 500, 0)) end
						end)
					end
				end))
	
				trackConn(RunService.RenderStepped:Connect(function()
					if not S.teleporterOn then return end
					local now = os.clock()
					if now - S.lastTeleportTick >= 1.0 then
						S.lastTeleportTick = now
						pcall(function()
							local _, root = getSafeParts()
							if root then
								local randomAngle = math.random() * math.pi * 2
