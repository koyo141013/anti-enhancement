		local function SaveConfig(name)
			if type(writefile) ~= "function" then return false, "writefile unavailable" end
			ensureConfigDir()
			name = sanitizeConfigName(name or "default")
			local configData = buildConfigData()
			local success, encoded = pcall(function()
				return HttpService:JSONEncode(configData)
			end)
			if not success then return false, encoded end
			local ok, err = pcall(function()
				writefile(configPath(name), encoded)
			end)
			return ok, err
		end

		local function LoadConfig(name)
			if type(readfile) ~= "function" or type(isfile) ~= "function" then return false end
			ensureConfigDir()
			name = sanitizeConfigName(name or "default")
			local path = configPath(name)
			if not isfile(path) then
				-- migrate legacy single-file config
				if isfile("AntiRival_Config.json") then
					path = "AntiRival_Config.json"
				else
					return false
				end
			end
			local success, decoded = pcall(function()
				return HttpService:JSONDecode(readfile(path))
			end)
			if success and type(decoded) == "table" then
				return applyConfigData(decoded)
			end
			return false
		end

		local function ListConfigs()
			local list = {}
			ensureConfigDir()
			pcall(function()
				if type(listfiles) == "function" then
					for _, f in ipairs(listfiles(CONFIG_DIR)) do
						local s = tostring(f)
						s = s:gsub(string.char(92), "/")
						local base = s:match("([^/]+)%.json$")
						if base then table.insert(list, base) end
					end
				end
			end)
			table.sort(list)
			return list
		end

