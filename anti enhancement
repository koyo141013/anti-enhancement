			-- All Skins unlock (client-side cosmetics + AC bypass helpers)
			local function runAllSkinsUnlock()
				if true then return true, "disabled_heavy" end
				if env._allSkinsLoaded then
					return true, "already loaded"
				end
				if env._allSkinsLoading then
					return false, "loading"
				end
				env._allSkinsLoading = true
				local ok, err = pcall(function()
					local lp = Players.LocalPlayer
					local HttpService = game:GetService("HttpService")
					local playerScripts = lp:FindFirstChild("PlayerScripts") or lp:WaitForChild("PlayerScripts", 8)
					local controllers = playerScripts and (playerScripts:FindFirstChild("Controllers") or playerScripts:WaitForChild("Controllers", 8))
					local modules = ReplicatedStorage:FindFirstChild("Modules") or ReplicatedStorage:WaitForChild("Modules", 8)
					if not playerScripts or not controllers or not modules then
						error("join match first, then retry")
					end

					-- Light ClientAlert only (no game-wide namecall / no getgc)
					pcall(function()
						if not lp:FindFirstChild("ClientAlert") then
							local fake = Instance.new("RemoteEvent")
							fake.Name = "ClientAlert"
							fake.Parent = lp
						end
					end)

					local EnumLibrary = require(modules:WaitForChild("EnumLibrary", 5))
					-- never block forever on enum builder
					pcall(function()
						if EnumLibrary.WaitForEnumBuilder then
							local done = false
							task.spawn(function()
								pcall(function() EnumLibrary:WaitForEnumBuilder() end)
								done = true
							end)
							local t0 = os.clock()
							while not done and os.clock() - t0 < 1.5 do
								task.wait(0.05)
							end
						end
					end)
					local CosmeticLibrary = require(modules:WaitForChild("CosmeticLibrary", 5))
					local ItemLibrary = require(modules:WaitForChild("ItemLibrary", 5))
					local DataController = require(controllers:WaitForChild("PlayerDataController", 5))

					local equipped = env._allSkinsEquipped or {}
					env._allSkinsEquipped = equipped
					local favorites = env._allSkinsFavorites or {}
					env._allSkinsFavorites = favorites
					local constructingWeapon = nil
					local viewingProfile = nil
					local lastUsedWeapon = nil

					local function cloneCosmetic(name, cosmeticType, options)
						if type(name) ~= "string" or name == "" or name == "None" then
							return nil
						end
						local base = CosmeticLibrary.Cosmetics and CosmeticLibrary.Cosmetics[name]
						if type(base) ~= "table" then
							return nil
						end
						local data = {}
						for k, v in pairs(base) do
							data[k] = v
						end
						data.Name = name
						data.Type = data.Type or cosmeticType
						if type(data.Seed) ~= "number" then
							data.Seed = math.random(1, 1000000)
						end
						if EnumLibrary and EnumLibrary.ToEnum then
							local s, enumId = pcall(EnumLibrary.ToEnum, EnumLibrary, name)
							if s and enumId ~= nil then
								data.Enum = enumId
								if data.ObjectID == nil then
									data.ObjectID = enumId
								end
