		local function applyKiciaSkybox(name)
			local preset = KICIA_SKYBOXES[name]
			if type(preset) ~= "table" then return false end
			return pcall(function()
				local sky = Lighting:FindFirstChildOfClass("Sky")
				if not sky then
					sky = Instance.new("Sky")
					sky.Parent = Lighting
				end
				for k, v in pairs(preset) do
					pcall(function()
						if k == "StarCount" then
							sky.StarCount = v
						elseif k == "SunAngularSize" then
							Lighting.SunAngularSize = v
						elseif k == "MoonAngularSize" then
							Lighting.MoonAngularSize = v
						elseif k == "SunTextureId" then
							-- Lighting may not support; try sky
							pcall(function() sky.SunTextureId = v end)
						elseif k == "MoonTextureId" then
							pcall(function() sky.MoonTextureId = v end)
						else
							sky[k] = v
						end
					end)
				end
				S.skyboxName = name
			end)
		end
		env._applyKiciaSkybox = applyKiciaSkybox

