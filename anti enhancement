				local function applyCosmeticToWeapon(weapon, cosmeticName, ctype)
					if not weapon or weapon == "" then return false end
					ctype = ctype or "Skin"
					equip[weapon] = equip[weapon] or {}
					local selected
					if not cosmeticName or cosmeticName == "" or cosmeticName == "None" then
						equip[weapon][ctype] = nil
						if equip[weapon] and not next(equip[weapon]) then equip[weapon] = nil end
					else
						selected = clonecos(cosmeticName, ctype)
						if not selected then return false end
						equip[weapon][ctype] = selected
					end
					task.defer(function()
						if type(selected) ~= "table" or not fctrl then return end
						pcall(function()
							local fighter = fctrl.LocalFighter or (fctrl.GetFighter and fctrl:GetFighter(lp))
							if not fighter then return end
							for _, it in pairs(fighter.Items or {}) do
								local n = it.Name
								pcall(function()
