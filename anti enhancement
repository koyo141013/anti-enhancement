								end)
								if n == weapon then
									pcall(function()
										if type(it.Set) == "function" then it:Set(ctype, selected) end
									end)
									break
								end
							end
						end)
					end)
					return true
				end

				SkinState.Apply = applyCosmeticToWeapon
				env._applyCosmeticToWeapon = applyCosmeticToWeapon
				env._harionCoss = coss
				env._harionFctrl = fctrl
				SkinState.Ready = true
				env._harionSkinSystemReady = true
				print("[anti-enhancement] Skin ready (safe GetWeaponData only — no Get/Replicate hooks)")
			end)
